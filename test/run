#!/bin/zsh
# 目的: test/ 配下の検証ハーネスをまとめて実行する
# 入力: 引数なしで全ツール / ツール名を渡すとそれだけ（例: ./test/run excel2md）
# 出力: 各ハーネスの合否一覧。1つでも落ちたら exit 1
# 例:   ./test/run          ./test/run excel2md          ./test/run excel2md --shots

set -euo pipefail

# asdf の shim を避ける（GUI 起動時に node が解決できない問題と同根。CLAUDE.md の制約）
export PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"

cd "${0:A:h}/.."

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  print -r -- "使い方: ./test/run [ツール名] [--shots]"
  print -r -- "  引数なし   test/ の全ハーネスを実行"
  print -r -- "  ツール名   そのハーネスだけ実行（test/<名前>.js）"
  print -r -- "  --shots    .playwright-mcp/ にスクリーンショットを書く（gitignore 済み）"
  exit 0
fi

if ! command -v node >/dev/null 2>&1; then
  print -r -- "node が見つかりません（PATH: $PATH）" >&2
  exit 1
fi

# 不可視文字の混入チェック。過去に2度やっている:
#   1) test/taskboard.js に NUL が1バイト → JS は動くが grep がバイナリ扱いして無言になる
#   2) web/taskboard.html に U+FE0F（異体字セレクタ）が5箇所 → 正規表現としては等価に動くため
#      テストでも検出できない。文字列リテラルに入れば比較が静かに失敗する
# 許可はタブ(09)と LF(0A) のみ。CR も検出する（このリポジトリは LF 統一）。
# 不可視ゆえ「行を見ても分からない」ので、どの文字かを U+XXXX で示す。
# 判定はバイト列で行う（-C フラグの出力エンコーディングに依存させない）。
# 対象は test/*.js・web/*.html・index.html・lib/*.js・このスクリプト自身
# （index.html は表示名を持つため、混入するとハブの検索が静かに壊れる）
if ! perl -ne '
      BEGIN { %CH = ("\xe2\x80\x8b" => "U+200B ゼロ幅スペース",
                     "\xef\xbb\xbf" => "U+FEFF BOM") }
      for my $seq (sort keys %CH) { report($CH{$seq}) if index($_, $seq) >= 0 }
      # U+FE0F は絵文字の表示を保証する正当な用途がある（favicon のハンマー＋レンチ等）。
      # その用途だけ内容で除外する（行番号で除外すると行が動いた瞬間に嘘になる）。
      # 他の場所に出たら落とす — 正規表現としては等価に動くのでテストでは捕まらないため。
      # このコメントに実物の絵文字を貼らないこと（自分自身が検出対象になる）
      report("U+FE0F 異体字セレクタ")
        if index($_, "\xef\xb8\x8f") >= 0 && !/rel="icon"/;
      while (/([\x00-\x08\x0B-\x1F])/g) { report(sprintf("U+%04X 制御文字", ord $1)) }
      close ARGV if eof;   # ファイルごとに $. を1に戻す（複数ファイルで行番号が累積するのを防ぐ）
      sub report { print "  $ARGV:$. に $_[0]\n"; $bad = 1 }
      END { exit($bad ? 1 : 0) }' test/*.js web/*.html index.html lib/*.js test/run; then
  print -r -- "不可視文字が混入しています（上記の行）。混入したまま検証しても結果が信用できません" >&2
  exit 1
fi

typeset -a targets
if [[ -n "${1:-}" && "${1}" != --* ]]; then
  targets=("test/${1}.js")
  shift
  if [[ ! -f "${targets[1]}" ]]; then
    print -r -- "ハーネスがありません: ${targets[1]}" >&2
    exit 1
  fi
else
  targets=(test/*.js)
  targets=(${targets:#test/helpers.js})   # 共通部品は単体実行しない
fi

failed=0
for harness in $targets; do
  print                      # -r は \n を解釈しないため空行は独立して出す
  print -r -- "### $harness"
  node "$harness" "$@" || failed=1
done

print
if (( failed )); then
  print -r -- "失敗したハーネスがあります" >&2
  exit 1
fi
print -r -- "すべて pass"
