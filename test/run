#!/bin/zsh
# 目的: test/ 配下の検証ハーネスをまとめて実行する
# 入力: 引数なしで全ツール / ツール名を渡すとそれだけ（例: ./test/run excel2md）
# 出力: 各ハーネスの合否一覧。1つでも落ちたら exit 1
# 例:   ./test/run          ./test/run excel2md          ./test/run excel2md --shots

set -euo pipefail

# asdf の shim を避ける（GUI 起動時に node が解決できない問題と同根。CLAUDE.md の制約）。
# homebrew の場所は環境で違うので3つとも並べる（Apple Silicon / Intel Mac / Linuxbrew）。
# 存在しないディレクトリが PATH にあっても害はない
export PATH="/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"

cd "${0:A:h}/.."

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  print -r -- "使い方: ./test/run [ツール名] [--shots]"
  print -r -- "  引数なし   test/ の全ハーネスを実行"
  print -r -- "  ツール名   そのハーネスだけ実行（test/<名前>.js）"
  print -r -- "  --shots    .playwright-mcp/ にスクリーンショットを書く（gitignore 済み）"
  exit 0
fi

if ! command -v node >/dev/null 2>&1; then
  print -r -- "node が見つかりません（PATH: $PATH）" >&2
  exit 1
fi

# 文字の混入チェック。過去に3度やっている:
#   1) test/taskboard.js に NUL が1バイト → JS は動くが grep がバイナリ扱いして無言になる
#   2) web/taskboard.html に U+FE0F（異体字セレクタ）が5箇所 → 正規表現としては等価に動くため
#      テストでも検出できない。文字列リテラルに入れば比較が静かに失敗する
#   3) docs/specs/devpad.md にキリル文字の s（ホモグリフ）→ 不可視ではないため
#      1・2 のチェックでは拾えず、目視で気づいた
# 方式は**ホワイトリスト**: 許可した範囲の外の文字はすべて落とす。
# 2026-08-06 に全対象ファイルを棚卸しし、実在する非ASCII文字（968種）が
# 下の範囲に収まることを確認した。新しい文字を意図して使うときは範囲を足す
# （＝意識的な判断を強制する。ブラックリストでは未知のホモグリフを取り逃す）。
# これで拾えるようになるもの: キリル/ギリシャ文字のホモグリフ・双方向制御文字
# （trojan source）・U+2028/2029（JS の文字列を壊す）・不正な UTF-8 バイト列。
# 許可する制御文字はタブ(09)と LF(0A) のみ。CR も検出する（このリポジトリは LF 統一）。
# 不可視・見分けが付かないゆえ「行を見ても分からない」ので、U+XXXX と Unicode 文字名を出す。
if ! perl -MEncode -ne '
      BEGIN {
        require charnames;
        # 許可範囲（棚卸しで実在を確認したものだけ）
        @ALLOW = ([0x00A7,0x00A7],[0x00B0,0x00B1],[0x00B7,0x00B7],[0x00D7,0x00D7],[0x00F7,0x00F7],
                  [0x2010,0x2027],[0x2030,0x2030],[0x2032,0x2033],[0x203B,0x203B],[0x2044,0x2044],
                  [0x2190,0x21FF],[0x2200,0x22FF],[0x2300,0x23FF],[0x2460,0x24FF],
                  [0x2500,0x257F],[0x25A0,0x25FF],[0x2600,0x27BF],[0x2B00,0x2BFF],
                  [0x3000,0x30FF],[0x31F0,0x31FF],[0x3200,0x33FF],[0x3400,0x4DBF],[0x4E00,0x9FFF],
                  [0xF900,0xFAFF],[0xFE30,0xFE6F],[0xFF00,0xFFEF],[0x1F000,0x1FAFF]);
        # 0x3200-0x33FF（囲み CJK・CJK 互換）と 0xFE30-0xFE6F（小字形・互換形）は
        # norm の NFKC テストが正当に使う（(株) キロ 小さいハイフン等）
        %SPECIAL = (0x200B => "U+200B ゼロ幅スペース",
                    0xFEFF => "U+FEFF BOM",
                    0xFE0E => "U+FE0E 異体字セレクタ（テキスト表示）",
                    0xFE0F => "U+FE0F 異体字セレクタ（絵文字表示）",
                    0xFFFD => "U+FFFD 不正な UTF-8 バイト列");
      }
      $s = Encode::decode("UTF-8", $_);
      @c = split //, $s;
      for my $i (0 .. $#c) {
        my $o = ord($c[$i]);
        if ($o < 0x20 && $o != 9 && $o != 10) { report(sprintf("U+%04X 制御文字", $o)); next }
        if ($o == 0x7F) { report("U+007F 制御文字（DEL）"); next }
        next if $o < 0x80;
        if (exists $SPECIAL{$o}) {
          # 異体字セレクタには正当な用途がある。**用途ごとに条件を書いて許す**
          # （行番号で除外すると行が動いた瞬間に嘘になる）:
          #   U+FE0F = favicon の絵文字（ハンマー＋レンチ等）を絵文字として表示させる
          #   U+FE0E = 取り消しボタンの左向き矢印を絵文字化させない（直前が U+21A9 のときだけ）
          # このコメントに実物の絵文字を貼らないこと（自分自身が検出対象になる）
          next if $o == 0xFE0F && /rel="icon"/;
          next if $o == 0xFE0E && $i > 0 && ord($c[$i-1]) == 0x21A9;
          report($SPECIAL{$o});
          next;
        }
        # AppleScript の生コード構文（U+00AB + class utf8 + U+00BB のような書き方）は
        # 二重山括弧が必須。**osascript を含む行でだけ**許す
        # （行番号での除外は行が動くと嘘になる。ここに実物の記号を書かないこと＝自己検出する）
        next if ($o == 0x00AB || $o == 0x00BB) && /osascript/;
        next if grep { $o >= $_->[0] && $o <= $_->[1] } @ALLOW;
        my $name = charnames::viacode($o) || "名称不明";
        report(sprintf("U+%04X %s（%s）", $o, $name, risk($o)));
      }
      close ARGV if eof;   # ファイルごとに $. を1に戻す（複数ファイルで行番号が累積するのを防ぐ）
      sub report {
        my $key = "$ARGV:$.:$_[0]";
        return if $SEEN{$key}++;
        print "  $ARGV:$. に $_[0]\n";
        $bad = 1;
      }
      # 何が危ないのかを名前だけに頼らず示す
      sub risk {
        my $o = shift;
        return "双方向制御。trojan source の手口" if ($o >= 0x202A && $o <= 0x202E)
          || ($o >= 0x2066 && $o <= 0x2069) || $o == 0x200E || $o == 0x200F;
        return "行区切り。JS の文字列リテラルを壊す" if $o == 0x2028 || $o == 0x2029;
        return "ホモグリフの可能性" if ($o >= 0x0080 && $o <= 0x024F)
          || ($o >= 0x0370 && $o <= 0x04FF) || ($o >= 0x1E00 && $o <= 0x1EFF);
        return "許可範囲外";
      }
      END { exit($bad ? 1 : 0) }' \
      test/*.js web/*.html index.html lib/*.js test/run \
      docs/specs/*.md docs/*.md CLAUDE.md .cursor/rules/*.mdc(N); then
  print -r -- "使ってよい範囲外の文字が混入しています（上記の行）。" >&2
  print -r -- "意図した文字なら test/run の @ALLOW に範囲を追加してください" >&2
  exit 1
fi

# バナー API の引数順チェック（2026-08-07）。
# **型が無いので取り違えても落ちず banner-undefined になるだけ**（監査 R6-2）なので、
# 「種別の位置に既知の種別リテラルが来ているか」を静的に見る。
# 種別が来る位置は API ごとに違うので、**ファイルと関数名で使い分ける**:
#   showBanner(kind, text)          … 5ツール（第1引数）
#   showBanner(id, kind, text)      … devpad だけ（第2引数。タブごとにバナー要素が違うため）
#   ToolUI.banner(el, kind, text)   … 共通核の呼び出し（第2引数）
# 種別が変数・三項演算子の呼び出しは判定しない（リテラルのときだけ検査する）。
if ! perl -ne '
      BEGIN { %KIND = map { $_ => 1 } qw(info warn error success) }
      next if /^\s*(\/\/|\*)/;                 # コメント行は見ない
      next if /function\s+showBanner\s*\(/;     # 定義行は対象外
      # 第 N 引数が文字列リテラルなら種別でなければならない、という共通の判定
      sub want_kind {
        my ($label, $arg) = @_;
        return unless defined $arg;
        # 種別以外の**あらゆる文字列リテラル**を落とす（[a-z]+ に限ると
        # 日本語のメッセージが素通りする。2026-08-07 に実測して修正）
        if ($arg =~ /^\x27([^\x27]*)\x27$/ && !$KIND{$1}) {
          print "  $ARGV:$. $label: $arg\n"; $bad = 1;
        }
      }
      if ($ARGV =~ /devpad\.html$/) {
        want_kind("showBanner の第2引数が種別ではありません", $1)
          if /\bshowBanner\(\s*[^,]+,\s*([^,)]*)/;
      } else {
        want_kind("showBanner の第1引数が種別ではありません", $1)
          if /\bshowBanner\(\s*(?!\s)([^,)]*)/;
      }
      want_kind("ToolUI.banner の第2引数が種別ではありません", $1)
        if /\bToolUI\.banner\(\s*[^,]+,\s*([^,)]*)/;
      close ARGV if eof;
      END { exit($bad ? 1 : 0) }' web/*.html lib/*.js test/*.js; then
  print -r -- "バナー API の引数順が統一形と違います（上記の行）。" >&2
  print -r -- "showBanner(kind, text)／devpad だけ showBanner(id, kind, text)／" >&2
  print -r -- "ToolUI.banner(el, kind, text) に揃えてください" >&2
  print -r -- "配列を受け取る excel2md は showWarningBanner という別名です" >&2
  exit 1
fi

typeset -a targets
if [[ -n "${1:-}" && "${1}" != --* ]]; then
  targets=("test/${1}.js")
  shift
  if [[ ! -f "${targets[1]}" ]]; then
    print -r -- "ハーネスがありません: ${targets[1]}" >&2
    exit 1
  fi
else
  targets=(test/*.js)
  targets=(${targets:#test/helpers.js})   # 共通部品は単体実行しない
fi

failed=0
for harness in $targets; do
  print                      # -r は \n を解釈しないため空行は独立して出す
  print -r -- "### $harness"
  node "$harness" "$@" || failed=1
done

print
if (( failed )); then
  print -r -- "失敗したハーネスがあります" >&2
  exit 1
fi
print -r -- "すべて pass"
